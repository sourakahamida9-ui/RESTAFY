{
  "name": "restafy-monorepo",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "dev": "pnpm --filter @restafy/web dev",
    "build": "pnpm --filter @restafy/web build",
    "build:analyze": "pnpm --filter @restafy/web build:analyze",
    "preview": "pnpm --filter @restafy/web preview",
    "clean": "pnpm -r --parallel clean && rm -rf node_modules .turbo",
    "lint": "pnpm --filter @restafy/web lint && tsc --noEmit -p api/tsconfig.json",
    "lint:shared": "pnpm --filter @restafy/shared lint",
    "check": "pnpm run lint && pnpm run build",
    "healthcheck": "pnpm run build && pnpm run lint",
    "test": "pnpm --filter @restafy/web test",
    "test:ui": "pnpm --filter @restafy/web test:ui",
    "test:run": "pnpm --filter @restafy/web test:run"
  },
  "devDependencies": {
    "@vercel/node": "^5.7.12",
    "turbo": "^2.5.6",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@9.15.4"
}
