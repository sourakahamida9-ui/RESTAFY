# ============================================================================
# Cross-Subdomain Authentication Configuration
# ============================================================================

# ====================
# JWT Configuration
# ====================

# ✅ CRITICAL: Change this in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345

# JWT Issuer (identifies this auth system)
JWT_ISSUER=restafy-sso

# JWT Audience (who can use these tokens)
JWT_AUDIENCE=restafy-subdomain-auth

# ====================
# Subdomain Configuration
# ====================

# Main domain (controls cookie domain)
MAIN_DOMAIN=restafy.shop

# Subdomains that can share auth
ALLOWED_SUBDOMAINS=scan,app,www,api

# List of allowed origins for CORS
ALLOWED_ORIGINS=https://scan.restafy.shop,https://app.restafy.shop,https://www.restafy.shop,http://localhost:3000,http://localhost:3001,http://localhost:5173

# ====================
# Session Configuration
# ====================

# Session token durations (in seconds)
SESSION_DURATION_AGENT_SCAN=$((8 * 60 * 60))       # 8 hours
SESSION_DURATION_MANAGER=$((12 * 60 * 60))         # 12 hours
SESSION_DURATION_ADMIN=$((24 * 60 * 60))           # 24 hours
SESSION_DURATION_CLIENT=$((7 * 24 * 60 * 60))      # 7 days

# Refresh token duration
REFRESH_TOKEN_DURATION=$((30 * 24 * 60 * 60))      # 30 days

# ====================
# Cookie Configuration
# ====================

# Cookie name for session token
AUTH_COOKIE_NAME=auth-session

# Cookie name for refresh token
AUTH_REFRESH_COOKIE_NAME=auth-refresh

# Enable httpOnly cookies (MUST be true in production)
COOKIES_HTTP_ONLY=true

# Enable secure flag (HTTPS only) - false for development
COOKIES_SECURE=false
# COOKIES_SECURE=true  # Uncomment for production

# ====================
# CORS Configuration
# ====================

# Enable CORS for cross-subdomain requests
CORS_ENABLED=true

# CORS credentials (must be true for cookies)
CORS_CREDENTIALS=true

# CORS max age (in seconds)
CORS_MAX_AGE=86400

# ====================
# Security Configuration
# ====================

# Enable IP validation (prevent token stolen from other locations)
VALIDATE_IP_ADDRESS=false
# VALIDATE_IP_ADDRESS=true  # Uncomment for production

# Enable User-Agent validation (prevent token usage from different browsers)
VALIDATE_USER_AGENT=false
# VALIDATE_USER_AGENT=true  # Uncomment for production

# Enable token revocation checking
CHECK_TOKEN_REVOCATION=false
# CHECK_TOKEN_REVOCATION=true  # Uncomment for production (requires DB)

# ====================
# Logging & Monitoring
# ====================

# Log authentication events
LOG_AUTH_EVENTS=true

# Log token validation details
LOG_TOKEN_VALIDATION=false

# Log CORS rejections
LOG_CORS_REJECTIONS=true

# ====================
# Database Configuration (for session storage)
# ====================

# Optional: Store sessions in database instead of memory
# DATABASE_URL=postgresql://user:password@localhost/restafy

# Optional: Redis for session caching
# REDIS_URL=redis://localhost:6379

# ====================
# Feature Flags
# ====================

# Enable offline PWA support (IndexedDB)
PWA_OFFLINE_SUPPORT=true

# Enable automatic token refresh
AUTO_REFRESH_TOKENS=true

# Require token refresh before 5 minutes of expiry
PREEMPTIVE_REFRESH=true

# ====================
# API Configuration
# ====================

# API server hostname for token validation
API_HOSTNAME=api.restafy.shop
# API_HOSTNAME=localhost:3001  # For development

# ====================
# Development Configuration
# ====================

# Only set these during development!
if [ "$NODE_ENV" = "development" ]; then
  # Allow localhost subdomains
  ALLOWED_ORIGINS="$ALLOWED_ORIGINS,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"
  
  # Disable secure flag for local testing
  COOKIES_SECURE=false
  
  # Enable detailed logging
  LOG_TOKEN_VALIDATION=true
fi

# ====================
# Production Checklist
# ====================

# Before deploying to production:
# 1. ✅ Set JWT_SECRET to a secure random value
# 2. ✅ Set COOKIES_SECURE=true
# 3. ✅ Set VALIDATE_IP_ADDRESS=true
# 4. ✅ Set VALIDATE_USER_AGENT=true
# 5. ✅ Set CHECK_TOKEN_REVOCATION=true
# 6. ✅ Setup DATABASE or REDIS for session storage
# 7. ✅ Configure ALLOWED_ORIGINS with actual production domains
# 8. ✅ Enable HTTPS on all subdomains
# 9. ✅ Test cross-subdomain cookies
# 10. ✅ Test CORS preflight requests
