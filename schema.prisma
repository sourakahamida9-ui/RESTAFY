generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  restaurant_owner
  manager
  staff
  livreur
  client
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  delivering
  delivered
  cancelled
}

enum PaymentMethod {
  USSD_MTN
  USSD_MOOV
  USSD_CELTIIS
  CASH
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum OrderType {
  delivery
  dine_in
  takeaway
}

model Restaurant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  address     String?
  city        String    @default("Cotonou")
  phone       String?
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  isOpen      Boolean   @default(false) @map("is_open")
  settings    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  profiles    Profile[]
  categories  Category[]
  items       Item[]
  orders      Order[]
  payments    Payment[]
  events      Event[]
  aiLogs      AiDataLog[]
  analytics   AnalyticsEvent[]
  tables      RestaurantTable[]

  @@map("restaurants")
}

model RestaurantTable {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String  @map("restaurant_id") @db.Uuid
  tableNumber  String  @map("table_number")
  capacity     Int     @default(4)
  positionX    Int?    @map("position_x")
  positionY    Int?    @map("position_y")
  isActive     Boolean @default(true) @map("is_active")
  qrCodeUrl    String? @map("qr_code_url")
  notes        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, tableNumber])
  @@map("restaurant_tables")
}

model Profile {
  id            String      @id @db.Uuid
  fullName      String?     @map("full_name")
  phone         String?     @unique
  role          UserRole    @default(client)
  restaurantId  String?     @map("restaurant_id") @db.Uuid
  avatarUrl     String?     @map("avatar_url")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  orders        Order[]
  ticketPurchases TicketPurchase[]
  loyaltyPoints LoyaltyPoints[]
  aiLogs        AiDataLog[]

  @@map("profiles")
}

model Category {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String      @map("restaurant_id") @db.Uuid
  name          String
  description   String?
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         Item[]

  @@map("categories")
}

model Item {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String      @map("restaurant_id") @db.Uuid
  categoryId    String?     @map("category_id") @db.Uuid
  name          String
  description   String?
  price         Decimal     @db.Decimal(12, 2)
  imageUrl      String?     @map("image_url")
  isAvailable   Boolean     @default(true) @map("is_available")
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ItemVariant[]
  orderItems    OrderItem[]

  @@map("items")
}

model ItemVariant {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String      @map("item_id") @db.Uuid
  name          String
  priceOverride Decimal?    @map("price_override") @db.Decimal(12, 2)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@map("item_variants")
}

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String        @map("restaurant_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  status          OrderStatus   @default(pending)
  type            OrderType
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  deliveryAddress String?       @map("delivery_address")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Profile?      @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]

  @@map("orders")
}

model OrderItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  itemId      String      @map("item_id") @db.Uuid
  variantId   String?     @map("variant_id") @db.Uuid
  quantity    Int         @default(1)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal     @db.Decimal(12, 2)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])
  variant     ItemVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  restaurantId    String        @map("restaurant_id") @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  amount          Decimal       @db.Decimal(12, 2)
  transactionRef  String?       @unique @map("transaction_ref")
  providerResponse Json?        @map("provider_response")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  order           Order?        @relation(fields: [orderId], references: [id])
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id])

  @@map("payments")
}

model Event {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String?     @map("restaurant_id") @db.Uuid
  title         String
  description   String?
  startTime     DateTime    @map("start_time") @db.Timestamptz
  endTime       DateTime?   @map("end_time") @db.Timestamptz
  location      String?
  imageUrl      String?     @map("image_url")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  tickets       EventTicket[]

  @@map("events")
}

model EventTicket {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String      @map("event_id") @db.Uuid
  name              String
  price             Decimal     @db.Decimal(12, 2)
  quantityAvailable Int         @map("quantity_available")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  event             Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purchases         TicketPurchase[]

  @@map("event_tickets")
}

model TicketPurchase {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String      @map("ticket_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  qrCodeData    String      @unique @map("qr_code_data")
  isUsed        Boolean     @default(false) @map("is_used")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  ticket        EventTicket @relation(fields: [ticketId], references: [id])
  customer      Profile?    @relation(fields: [customerId], references: [id])

  @@map("ticket_purchases")
}

model LoyaltyPoints {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String      @map("customer_id") @db.Uuid
  restaurantId  String      @map("restaurant_id") @db.Uuid
  points        Int         @default(0)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  customer      Profile     @relation(fields: [customerId], references: [id])

  @@map("loyalty_points")
}

model AiDataLog {
  id            BigInt      @id @default(autoincrement())
  restaurantId  String?     @map("restaurant_id") @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  actionType    String      @map("action_type")
  payload       Json
  context       Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  user          Profile?    @relation(fields: [userId], references: [id])

  @@map("ai_data_logs")
}

model AnalyticsEvent {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String?     @map("restaurant_id") @db.Uuid
  eventName     String      @map("event_name")
  properties    Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])

  @@map("analytics_events")
}
