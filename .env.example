# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
VITE_APP_NAME=Restafy
# URL publique de l’app (pas la vitrine). Ex. prod : https://app.restafy.shop — pour les liens e-mail / API.
VITE_APP_URL=https://app.restafy.shop
VITE_ENVIRONMENT=production

# Optionnel — origines autorisées pour POST /api/partner-join-request (et /api/public/partner-join-request, alias)
# PARTNER_JOIN_CORS_ORIGINS=https://www.restafy.shop,https://restafy.shop

# ── Projet Vercel séparé « landing » (vitrine) — voir landing/.env.example ──
# Obligatoire sur le projet app : SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
# Le formulaire vitrine appelle https://app.restafy.shop/api/partner-join-request (CORS).
# Supabase : exécuter scripts/083-partner-join-requests.sql puis 087 si INSERT refusé (service_role).

# ══════════════════════════════════════════════════════════════════════════════
# Email Service (Resend) - SERVEUR UNIQUEMENT (securise)
# ══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: La cle API email doit etre configuree sur VERCEL, pas ici!
# Vercel Dashboard -> Settings -> Environment Variables -> RESEND_API_KEY
# Les variables VITE_* sont exposees dans le bundle client - NE PAS utiliser pour les cles API!

# Optional: Log email attempts to database (cote client)
VITE_LOG_EMAILS_TO_DB=false

# USSD Payment Providers (for Phase 6)
# Secrets serveur uniquement (Edge Function / API route) - ne jamais prefixer avec VITE_
USSD_MTN_API_KEY=
USSD_MOOV_API_KEY=
USSD_CELTIIS_API_KEY=

# AI/Analytics (for Phase 8)
VITE_AI_GATEWAY_URL=

# Import menu par photo : Edge Function Supabase `gemini-menu-import`
# ⚠️ La clé Google (GEMINI_API_KEY) doit être un SECRET SUPABASE (Dashboard → Edge Functions → Secrets).
#    Ni VITE_* ni une variable « GEMINI_API_KEY » sur Vercel ne sont lues par gemini-menu-import.
# En local : supabase functions serve gemini-menu-import --env-file supabase/.env.local
# puis : VITE_MENU_IMPORT_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/gemini-menu-import
# Prod : supabase secrets set GEMINI_API_KEY=votre_clé && supabase functions deploy gemini-menu-import
# Optionnel : GEMINI_MODEL=gemini-2.0-flash (sinon défaut gemini-1.5-flash dans la fonction)
VITE_MENU_IMPORT_FUNCTION_URL=

# Optional: Maps & Geolocation
VITE_MAPBOX_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
# Kkiapay Payment Integration
# Docs: https://docs.kkiapay.me — Dashboard: https://app.kkiapay.me/dashboard
# ══════════════════════════════════════════════════════════════════════════════
# Mode: 'sandbox' pour les tests, 'production' pour les vrais paiements
VITE_KKIAPAY_ENVIRONMENT=sandbox

# Clé PUBLIQUE uniquement (côté client) — obtention: https://app.kkiapay.me/dashboard → API Keys
VITE_KKIAPAY_PUBLIC_KEY=

# ⚠️ SECRETS BACKEND UNIQUEMENT (serverless functions)
# Jamais de préfixe VITE_ pour les secrets !
# Configurer dans Vercel Dashboard → Settings → Environment Variables
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true  # 'true' pour sandbox, 'false' pour production
